{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot plot: share of each group that attended a live arts event or festival in 2025, compared with the national figure of 74% (vertical line).",
  "width": "container",
  "height": 340,
  "data": { "url": "data/naps_attendance_groups.csv", "format": { "type": "csv", "parse": { "rate": "number" } } },
  "transform": [{ "calculate": "datum.dimension + ': ' + datum.group", "as": "label" }],
  "encoding": {
    "y": { "field": "label", "type": "nominal", "title": null, "sort": null, "axis": { "labelLimit": 260, "grid": true } },
    "x": { "field": "rate", "type": "quantitative", "title": "Attended a live arts event or festival, 2025 (%)", "scale": { "domain": [50, 90] } }
  },
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 2, "color": "#c9c6bf" },
      "encoding": { "x2": { "datum": 74 } }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 130, "opacity": 1, "stroke": "#fcfcfb", "strokeWidth": 2 },
      "encoding": {
        "color": { "condition": { "test": "datum.rate < 74", "value": "#e34948" }, "value": "#2a78d6" },
        "tooltip": [
          { "field": "dimension", "title": "Group" },
          { "field": "group", "title": "Category" },
          { "field": "rate", "title": "Attended (%)" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#52514e", "strokeDash": [4, 3] },
      "encoding": { "x": { "datum": 74 }, "y": { "value": 0 }, "y2": { "value": 340 } }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 5, "dy": -6, "fontSize": 11, "color": "#52514e", "text": "All Australians: 74%" },
      "encoding": { "x": { "datum": 74 }, "y": { "value": 0 } }
    }
  ]
}
